# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL, used for canonical links, sitemap, and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB. Points at the shared Docker container on host port 27018 with this
# project's own database name so it does not collide with other projects.
MONGODB_URI=mongodb://127.0.0.1:27018/train-with-awad

# Resend (email). A placeholder key is fine for local development — email sends
# are skipped unless a real key is set.
RESEND_API_KEY=re_placeholder_local_only
EMAIL_FROM=Train With Awad <onboarding@resend.dev>
COACH_NOTIFY_EMAIL=coach@example.com

# Stripe (payments). Test-mode keys only in development. Never a live key.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- Admin / CMS ---
# Session signing secret (jose, HS256). Generate one: `openssl rand -base64 48`.
JWT_SECRET=change-me
# Seeded owner account; change the password after first sign-in.
ADMIN_EMAIL=coach@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Awad
# Passkeys (WebAuthn). rpID is the registrable domain; origin is scheme+host.
WEBAUTHN_RP_NAME=Train With Awad
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# Media storage: s3 (S3/MinIO) or imagekit.
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=train-with-awad
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://127.0.0.1:9000/train-with-awad

# ImageKit (alternative media storage). Set STORAGE_PROVIDER=imagekit to use it.
# Inert until an ImageKit provider is wired in src/server/storage — s3 is active.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
