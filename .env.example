# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL, used for canonical links, sitemap, and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB. Points at the shared Docker container on host port 27018 with this
# project's own database name so it does not collide with other projects.
MONGODB_URI=mongodb://127.0.0.1:27018/train-with-awad

# Resend (email). A placeholder key is fine for local development — email sends
# are skipped unless a real key is set.
RESEND_API_KEY=re_placeholder_local_only
EMAIL_FROM=Train With Awad <onboarding@resend.dev>
COACH_NOTIFY_EMAIL=coach@example.com

# Stripe (payments). Test-mode keys only in development. Never a live key.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
